# SIFT 配置示例
# Docker Compose 会自动读取同目录下的 .env；原生运行请用 shell 环境变量，
# 或在 Node 22+ 下使用 node --env-file=.env server/index.js。
# 复制为 .env 后按需修改：cp .env.example .env

# 监听端口（默认 8787）
SIFT_PORT=8787

# 监听地址。0.0.0.0 允许同一局域网内的手机访问（需访问码，只读）；
# 127.0.0.1 则只允许本机访问，更保守。
SIFT_HOST=0.0.0.0

# 数据目录，存放 state.json / sessions.json / config.json
# Docker 中固定为 /data，并挂载持久卷
SIFT_DATA_DIR=./data

# 额外允许的主机名，逗号分隔（仅限局域网使用，不要填公网域名）
# SIFT_ALLOWED_HOSTS=nas.local,sift.home

# 知乎同步书签使用的本机地址（默认 http://127.0.0.1:<端口>）
# SIFT_ORIGIN=http://127.0.0.1:8787

# B站自动同步间隔（毫秒，默认 20 分钟）；SIFT_NO_SYNC=1 关闭自动同步
SIFT_SYNC_MS=1200000

# B站 / 知乎内容保留天数（默认 180）
SIFT_BILI_DAYS=180
SIFT_ZHIHU_DAYS=180

# 最多保留的条目数（默认 1500）
SIFT_MAX_ITEMS=1500
